FROM python:3.11-slim

WORKDIR /app

# 使用国内镜像源加速 apt 和 pip
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true

# 1. 先安装系统依赖和 Python 依赖（不依赖模型文件，可缓存层）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    -i https://pypi.tuna.tsinghua.edu.cn/simple

# 2. COPY 本地预下载的模型文件（避免运行时下载，适合低带宽环境）
COPY models/ /app/models/

# 3. COPY 应用代码
COPY onto_service/ ./onto_service/

# 4. 设置模型环境变量，让 sentence-transformers 直接使用本地模型
ENV SENTENCE_TRANSFORMERS_HOME=/app/models
ENV HF_HOME=/app/models
ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1

EXPOSE 5001

CMD ["python", "-m", "uvicorn", "onto_service.main:app", "--host", "0.0.0.0", "--port", "5001"]
