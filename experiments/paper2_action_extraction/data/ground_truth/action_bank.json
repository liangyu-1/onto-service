      },
      "preconditions": [
        "user_authenticated == true"
      ],
      "effects": [
        "product cached in state"
      ],
      "constraints": [
        "user_authenticated == true"
      ],
      "target_object": "Product"
    },
    {
      "action_id": "get_item_details",
      "description": "Get details of a specific item/variant by its item ID.",
