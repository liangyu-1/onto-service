    {
      "action_id": "ask_for_confirmation",
      "description": "Ask the user for explicit confirmation before executing an update action (cancel, exchange, return, modify).",
      "parameters": {
        "action_description": "string - description of what you want to confirm"
      },
      "preconditions": [],
      "effects": [
        "user_confirmed = true"
      ],
      "constraints": [
        "user_authenticated == true"
      ],
      "target_object": "User"
    },
    {
      "action_id": "finish_task",
      "description": "Declare that all requested user-visible work has been completed. Use only after all required lookup, confirmation, and update actions have been executed.",
      "parameters": {},
