    {
      "action_id": "cancel_pending_order",
      "description": "Cancel a pending order. The order status must be 'pending'. Refund will be processed.",
      "parameters": {
        "order_id": "string - Order ID",
        "reason": "enum - Allowed cancellation reason - allowed values: ['no longer needed', 'ordered by mistake']"
      },
      "preconditions": [
        "order.status == 'pending'",
        "reason in ['no longer needed', 'ordered by mistake']"
      ],
      "effects": [
        "order.status = 'cancelled'",
        "trigger refund"
      ],
      "constraints": [
        "user_authenticated == true",
        "user_confirmed == true"
      ],
      "target_object": "Order",
      "action_kind": "mutate",
      "grounding_mode": "strong",
      "parameter_semantics": {
        "order_id": {
          "type": "string",
          "required": true,
          "role": "target_identifier",
          "description": "Order ID",
          "allowed_values": [],
          "ontology_property_id": "retail.property.Order.order_id"
        },
        "reason": {
          "type": "enum",
          "required": true,
          "role": "business_reason",
          "description": "Allowed cancellation reason",
          "allowed_values": [
            "no longer needed",
            "ordered by mistake"
          ],
          "ontology_property_id": "retail.property.Order.cancel_reason"
        }
      },
      "target_binding": {
        "parameter": "order_id",
        "role": "target_identifier"
      },
      "ontology_action_id": "retail.action.cancel_pending_order",
      "target_type_id": "retail.type.Order",
      "control_flow": {
        "requires_previous": [
          "find_user_id_by_email|find_user_id_by_name_zip",
          "get_order_details",
          "user_confirmed == true"
        ],
        "forbidden_after": []
      }
    },
