{"function_id":"inspect_damage","description":"Inspect a garment or part to locate the damaged area and repair target.","bound_object_types":["Garment"],"inputs":[{"name":"target","type":"Garment","semantic_role":"target_object","ontology_property":"Garment"}],"outputs":[{"name":"repair_target","type":"Garment","ontology_property":"Garment"}],"preconditions":[],"effects":["Garment.state -> prepared"]}
{"function_id":"open_seam","description":"Open or rip a seam to expose a pocket or repair area.","bound_object_types":["Seam","Pocket"],"inputs":[{"name":"seam","type":"Seam","semantic_role":"target_object","ontology_property":"Seam"},{"name":"pocket","type":"Pocket","semantic_role":"location","ontology_property":"Pocket"}],"outputs":[{"name":"opened_pocket","type":"Pocket","ontology_property":"Pocket"}],"preconditions":["Seam.state == closed"],"effects":["Seam.state -> opened","Pocket.state -> opened"]}
{"function_id":"insert_material","description":"Insert a material object into a target pocket or location.","bound_object_types":["Ribbon","Pocket"],"inputs":[{"name":"material","type":"Ribbon","semantic_role":"moved_object","ontology_property":"Ribbon"},{"name":"target","type":"Pocket","semantic_role":"target_location","ontology_property":"Pocket"}],"outputs":[{"name":"material","type":"Ribbon","ontology_property":"Ribbon"}],"preconditions":["Pocket.state == opened"],"effects":["Ribbon.state -> inserted","Pocket.state -> holding_ribbon"]}
{"function_id":"sew_material","description":"Sew material in place using an available sewing tool.","bound_object_types":["Garment","Ribbon","Tool"],"inputs":[{"name":"garment","type":"Garment","semantic_role":"workpiece","ontology_property":"Garment"},{"name":"material","type":"Ribbon","semantic_role":"target_object","ontology_property":"Ribbon"},{"name":"tool","type":"Tool","semantic_role":"tool","ontology_property":"Tool"}],"outputs":[{"name":"material","type":"Ribbon","ontology_property":"Ribbon"}],"preconditions":["Ribbon.state == inserted"],"effects":["Ribbon.state -> secured"]}
{"function_id":"secure_stitch","description":"Backstitch or otherwise secure stitches so the seam remains fixed.","bound_object_types":["Seam"],"inputs":[{"name":"seam","type":"Seam","semantic_role":"target_object","ontology_property":"Seam"}],"outputs":[{"name":"seam","type":"Seam","ontology_property":"Seam"}],"preconditions":[],"effects":["Seam.state -> stitched"]}
{"function_id":"thread_material_through_button","description":"Thread ribbon or similar material through a button.","bound_object_types":["Ribbon","Button"],"inputs":[{"name":"material","type":"Ribbon","semantic_role":"moved_object","ontology_property":"Ribbon"},{"name":"button","type":"Button","semantic_role":"target_object","ontology_property":"Button"}],"outputs":[{"name":"button","type":"Button","ontology_property":"Button"}],"preconditions":["Ribbon.state == secured"],"effects":["Ribbon.state -> threaded","Button.state -> threaded"]}
{"function_id":"trim_material","description":"Trim excess material from a repair workpiece.","bound_object_types":["Ribbon"],"inputs":[{"name":"material","type":"Ribbon","semantic_role":"target_object","ontology_property":"Ribbon"}],"outputs":[{"name":"material","type":"Ribbon","ontology_property":"Ribbon"}],"preconditions":[],"effects":["Ribbon.state -> trimmed"]}
