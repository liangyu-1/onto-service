{
  "actions": [
    {
      "action_id": "get_user_details",
      "description": "Get detailed information about a user including profile, membership, payment methods, and reservations.",
      "parameters": {
        "user_id": "string - user's unique identifier"
      },
      "preconditions": [
        "user_authenticated == true"
      ],
      "effects": [
        "user cached in state"
      ],
      "constraints": [
        "user_authenticated == true"
      ],
      "target_object": "User"
    },
    {
      "action_id": "get_reservation_details",
      "description": "Get details of a specific reservation including flights, passengers, baggage, and insurance.",
      "parameters": {
        "reservation_id": "string - reservation confirmation number"
      },
      "preconditions": [
        "user_authenticated == true"
      ],
      "effects": [
        "reservation cached in state"
      ],
      "constraints": [
        "user_authenticated == true"
      ],
      "target_object": "Reservation"
    },
    {
      "action_id": "search_direct_flight",
      "description": "Search for available direct flights between two airports on a specific date.",
      "parameters": {
        "origin": "string - origin airport code (e.g., PHL)",
        "destination": "string - destination airport code (e.g., LGA)",
        "date": "string - date in YYYY-MM-DD format"
      },
      "preconditions": [],
      "effects": [
        "matching flights cached in state"
      ],
      "constraints": [],
      "target_object": "Flight"
    },
    {
      "action_id": "book_reservation",
      "description": "Book a new flight reservation. Requires user confirmation before execution.",
      "parameters": {
        "user_id": "string",
        "origin": "string - origin airport code",
        "destination": "string - destination airport code",
        "flight_type": "string - 'one_way' or 'round_trip'",
        "cabin": "string - 'basic_economy', 'economy', or 'business'",
        "flights": "list of {flight_number, date} objects",
        "passengers": "list of {first_name, last_name, dob} objects (max 5)",
        "payment_methods": "list of {payment_id, amount} objects",
        "total_baggages": "integer - total number of checked bags",
        "nonfree_baggages": "integer - number of paid checked bags",
        "insurance": "string - 'yes' or 'no'"
      },
      "preconditions": [
        "len(passengers) <= 5",
        "cabin in ['basic_economy', 'economy', 'business']"
      ],
      "effects": [
        "new reservation created",
        "flight seats decremented",
        "user payment methods deducted"
      ],
      "constraints": [
        "user_authenticated == true",
        "user_confirmed == true",
        "referential_integrity == true"
      ],
      "target_object": "Reservation"
    },
    {
      "action_id": "update_reservation_flights",
      "description": "Change flights or cabin class in an existing reservation. Basic economy flights cannot be modified.",
      "parameters": {
        "reservation_id": "string",
        "cabin": "string - new cabin class",
        "flights": "list of {flight_number, date} objects",
        "payment_id": "string - payment method for price difference"
      },
      "preconditions": [
        "reservation.cabin != 'basic_economy' or cabin_change_only == true"
      ],
      "effects": [
        "reservation.flights updated",
        "reservation.cabin updated",
        "payment processed"
      ],
      "constraints": [
        "user_authenticated == true",
        "user_confirmed == true",
        "referential_integrity == true"
      ],
      "target_object": "Reservation"
    },
    {
      "action_id": "update_reservation_baggages",
      "description": "Update checked baggage count for a reservation. Can only add bags, not remove.",
      "parameters": {
        "reservation_id": "string",
        "total_baggages": "integer - new total bag count",
        "nonfree_baggages": "integer - new paid bag count",
        "payment_id": "string - payment method for extra bags"
      },
      "preconditions": [
        "total_baggages >= current_total_baggages"
      ],
      "effects": [
        "reservation.total_baggages updated",
        "reservation.nonfree_baggages updated"
      ],
      "constraints": [
        "user_authenticated == true",
        "user_confirmed == true",
        "referential_integrity == true"
      ],
      "target_object": "Reservation"
    },
    {
      "action_id": "update_reservation_passengers",
      "description": "Update passenger information. Cannot change the number of passengers.",
      "parameters": {
        "reservation_id": "string",
        "passengers": "list of {first_name, last_name, dob} objects"
      },
      "preconditions": [
        "len(passengers) == current_passenger_count"
      ],
      "effects": [
        "reservation.passengers updated"
      ],
      "constraints": [
        "user_authenticated == true",
        "user_confirmed == true"
      ],
      "target_object": "Reservation"
    },
    {
      "action_id": "cancel_reservation",
      "description": "Cancel a reservation. Allowed if: within 24h of booking, airline cancelled, business class, or has insurance with valid reason.",
      "parameters": {
        "reservation_id": "string"
      },
      "preconditions": [
        "reservation.can_cancel == true",
        "no_portion_flown == true"
      ],
      "effects": [
        "reservation.status = 'cancelled'",
        "flight seats released",
        "refund initiated"
      ],
      "constraints": [
        "user_authenticated == true",
        "user_confirmed == true"
      ],
      "target_object": "Reservation"
    },
    {
      "action_id": "transfer_to_human_agents",
      "description": "Transfer the conversation to a human agent when the request cannot be handled.",
      "parameters": {
        "summary": "string - summary of the issue"
      },
      "preconditions": [],
      "effects": [
        "transfer_to_human = true"
      ],
      "constraints": [],
      "target_object": ""
    },
    {
      "action_id": "calculate",
      "description": "Perform a calculation (e.g., price difference, baggage fees).",
      "parameters": {
        "expression": "string - math expression"
      },
      "preconditions": [],
      "effects": [],
      "constraints": [],
      "target_object": ""
    },
    {
      "action_id": "ask_for_confirmation",
      "description": "Ask the user for explicit confirmation before executing a booking, modification, or cancellation.",
      "parameters": {
        "action_description": "string - description of what you want to confirm"
      },
      "preconditions": [],
      "effects": [
        "user_confirmed = true"
      ],
      "constraints": [
        "user_authenticated == true"
      ],
      "target_object": "User"
    },
    {
      "action_id": "finish_task",
      "description": "Declare that all requested user-visible work has been completed.",
      "parameters": {},
      "preconditions": [],
      "effects": [
        "task completed"
      ],
      "constraints": [],
      "target_object": "Conversation"
    }
  ]
}
